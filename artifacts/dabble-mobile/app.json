{
  "expo": {
    "name": "Dabble",
    "slug": "dabble",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dabble",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#fcf7f1",
      "image": "./assets/images/icon.png",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dabble.app"
    },
    "android": {
      "package": "com.dabble.app"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}